{
  "paths": [
    "src/**/*.tsx",
    "src/**/*.css",
    "src/**/*.vue",
    "src/**/*.svelte",
    "public/**"
  ],
  "tokens": [
    "public/tokens.css"
  ],
  "start": "bun run start",
  "url": "http://localhost:3000",
  "routes": [
    "/"
  ],
  "viewports": [
    {
      "name": "phone",
      "width": 390,
      "height": 844
    },
    {
      "name": "desktop",
      "width": 1280,
      "height": 800
    }
  ],
  "themes": [
    "light",
    "dark"
  ],
  "ready_timeout": 60,
  "states": [
    {
      "name": "owner-share",
      "route": "/",
      "steps": [
        {
          "click": "#share"
        },
        {
          "wait": "#share-address a"
        }
      ]
    },
    {
      "name": "shared-view",
      "route": "/",
      "steps": [
        {
          "click": "#share"
        },
        {
          "wait": "#share-address a"
        },
        {
          "click": "#share-address a"
        },
        {
          "wait": "#links li"
        }
      ],
      "assert": {
        "hidden": [
          "form",
          "#share"
        ],
        "visible": "#links"
      }
    }
  ]
}
